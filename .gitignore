  # Python 缓存（tests/gen_fixtures.py 跑过就会留）
__pycache__/
*.pyc

# 构建产物 / 依赖 / 本机配置 —— 都不该进 git
work/
node_modules/
.cache/
conf/kit.conf
tests/package-lock.json
*.log

# 打包产物（要发布就传 Release，别塞进仓库）
*.zip
*.tar.gz

# ⚠️ Zotero 安装包 90 MB —— 不进 git（GitHub 对单文件 >50MB 会告警）。
#    用 scripts/fetch_zotero.sh 下载，它会校验 sha256。
#    vendor/zotero/README.md 里记了来源与签名指纹。
vendor/zotero/*.exe

# SI 插件重新打包的产物
plugins/si-fetcher/*-new.xpi
