 xml:space="preserve">2</w:t></w:r><w:r><w:rPr></w:rPr><w:t xml:space="preserve">CO</w:t></w:r><w:r><w:rPr><w:vertAlign w:val="subscript"/></w:rPr><w:t xml:space="preserve">3</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">with 0.42 cm3 g-1</w:t></w:r></w:p></w:tc></w:tr></w:tbl></w:body></w:document>