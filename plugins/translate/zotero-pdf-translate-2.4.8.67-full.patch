+      const paras =
+        tc.match(/<w:p(?:\s[^>]*)?>[\s\S]*?(?=<w:p(?:\s[^>]*)?>|<\/w:tc>)/g) ??
+        [];
+      const lines = paras
+        .map(paragraphTextWithScripts)
+        .filter((l) => l.length > 0);
