+function paragraphTextWithScripts(pp: string): string {
+  let out = "";
+  const runRe = /<w:r(?:\s[^>]*)?>[\s\S]*?<\/w:r>/g;
+  let m: RegExpExecArray | null;
+  while ((m = runRe.exec(pp))) {
+    const run = m[0];
+    const txt = Array.from(
