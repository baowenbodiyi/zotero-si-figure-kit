+        text: rows
+          .map((r) => r.join(" "))
+          .join(" ")
+          .replace(/\s+/g, " ")
+          .trim(),
+        images: [],
+        table: rows,
+      });
+    } else {
+      const para = parseParagraph(chunk);
+      paragraphs.push({
+        text: para.text,
+        images: para.images
+          .map((rid) => rid2media.get(rid) ?? "")
+          .filter((f) => !!f),
