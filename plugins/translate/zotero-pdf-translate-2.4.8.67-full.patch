+    flexDirection: "column",
+    // 浮在 PDF 与划词弹窗之上
+    zIndex: "2147483000",
+    background: "var(--color-sidepane, #f5f5f5)",
+    color: "var(--fill-primary, #111)",
+    border: "1px solid rgba(0,0,0,0.35)",
+    borderRadius: "8px",
+    boxShadow: "0 8px 28px rgba(0,0,0,0.35)",
+    overflow: "hidden",
+    boxSizing: "border-box",
+    fontSize: "13px",
+    lineHeight: "1.45",
