+  const extraLen = view.getUint16(p + 28, true);
+  const start = p + 30 + nameLen + extraLen;
+  const raw = u8.subarray(start, start + e.compSize);
+  if (e.method === 0) {
+    return raw;
+  }
+  if (e.method === 8) {
+    return inflateRaw(raw, e.uncompSize);
