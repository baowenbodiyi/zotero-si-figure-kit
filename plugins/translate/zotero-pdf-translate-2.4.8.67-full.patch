+  // ── 标题栏（拖动把手）
+  const head = el(doc, "div", {
+    display: "flex",
+    alignItems: "center",
+    gap: "6px",
+    padding: "5px 8px",
+    background: "rgba(127,127,127,0.22)",
+    cursor: "move",
+    flexShrink: "0",
+    userSelect: "none",
