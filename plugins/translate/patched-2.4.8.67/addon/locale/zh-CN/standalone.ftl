font-minus =
    .label = A-
    .tooltiptext = 减小字号（改的是全局「字号」，设置里同步）
font-plus =
    .label = A+
    .tooltiptext = 增大字号（改的是全局「字号」，设置里同步）
add-source =
    .label = 添加源
remove-source =
    .label = 移除
pin-window =
    .label = { $mode ->
        [pinned] 📌取消置顶
        *[other] 📍置顶
    }
font-family =
    .label = 字体
    .tooltiptext = 切换译文字体（跟随 Zotero / 宋体 / 雅黑 / 等宽），按钮上显示当前档位
